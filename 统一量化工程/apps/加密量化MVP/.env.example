# 应用配置
VITE_APP_TITLE=加密量化交易策略回测系统
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=专业级加密货币量化交易策略回测与分析平台

# API配置
VITE_API_BASE_URL=http://localhost:3001
VITE_API_TIMEOUT=30000

# 开发环境配置
NODE_ENV=development
PORT=3001

# 数据库配置（如需要）
# DATABASE_URL=postgresql://username:password@localhost:5432/quant_db

# 第三方API配置（如需要）
# BINANCE_API_KEY=your_binance_api_key
# BINANCE_SECRET_KEY=your_binance_secret_key
# OKEX_API_KEY=your_okex_api_key
# OKEX_SECRET_KEY=your_okex_secret_key
# OKEX_PASSPHRASE=your_okex_passphrase

# 日志配置
LOG_LEVEL=info

# 安全配置
JWT_SECRET=your_jwt_secret_key_here
CORS_ORIGIN=http://localhost:5173